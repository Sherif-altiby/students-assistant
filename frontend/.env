# Server-only — used by next.config.mjs rewrites, never sent to the browser
API_URL=http://localhost:3000/api/v1

# Public — this is what the browser (axios, lib/api.ts) actually calls.
# It's a relative path, so it's always same-origin as your Next.js app,
# regardless of what port Next.js itself runs on.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Sockets can't be proxied through rewrites the same way — keep this pointing
# directly at the backend. This is a separate concern from cookies/middleware.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000