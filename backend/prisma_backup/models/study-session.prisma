model StudyTableSubject {
  id           String       @id @default(uuid())
  studyTableId String       @map("study_table_id")
  studyTable   StudyTable   @relation(fields: [studyTableId], references: [id], onDelete: Cascade)
  subjectId    String       @map("subject_id")
  subject      StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @map("created_at")

  @@unique([studyTableId, subjectId])
  @@index([subjectId])
  @@map("study_table_subjects")
}

model StudySession {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyTableId   String       @map("study_table_id")
  studyTable     StudyTable   @relation(fields: [studyTableId], references: [id], onDelete: Cascade)
  dayId          String       @map("day_id")
  day            StudyDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  subjectId      String       @map("subject_id")
  subject        StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessonId       String       @map("lesson_id")
  lesson         StudyLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order          Int          @default(0)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  lateNotifiedAt DateTime?    @map("late_notified_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([studyTableId, lessonId])
  @@index([dayId])
  @@index([subjectId])
  @@index([lessonId])
  @@index([completedAt, lateNotifiedAt])
  @@map("study_sessions")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  data       Json?
  dedupeKey  String?          @unique @map("dedupe_key")
  readAt     DateTime?        @map("read_at")
  resolvedAt DateTime?        @map("resolved_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, type, resolvedAt])
  @@map("notifications")
}
