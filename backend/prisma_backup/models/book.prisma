// prisma/models/book.prisma

model Book {
  id       String  @id @default(uuid())
  title    String
  language String?

  ownerId String @map("owner_id")
  owner   User   @relation("BookOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Optional link to the existing study subject
  subjectId String?       @map("subject_id")
  subject   StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  level EducationLevel?
  track Track?

  visibility BookVisibility       @default(PRIVATE)
  moderation BookModerationStatus @default(ACTIVE)
  status     BookProcessingStatus @default(UPLOADING)

  failureReason String? @map("failure_reason")
  progress      Int     @default(0) // 0 to 100
  pageCount     Int?    @map("page_count")

  fileKey  String  @unique @map("file_key") // object key in Cloudflare R2
  fileSize Int     @map("file_size")
  fileHash String? @map("file_hash")

  publishedAt DateTime? @map("published_at")

  pages         BookPage[]
  chunks        BookChunk[]
  summaries     BookSummaryCache[]
  conversations AiConversation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([visibility, moderation, status])
  @@index([fileHash])
  @@map("books")
}

// Full text of each page (used for "explain page X" and summaries)
model BookPage {
  id String @id @default(uuid())

  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  pageNumber   Int     @map("page_number") // index inside the PDF file
  printedLabel String? @map("printed_label") // number printed on the page
  text         String
  lowQuality   Boolean @default(false) @map("low_quality")
  usedOcr      Boolean @default(false) @map("used_ocr")

  @@unique([bookId, pageNumber])
  @@map("book_pages")
}

// Small pieces used for vector search
model BookChunk {
  id String @id @default(uuid())

  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  pageNumber Int    @map("page_number")
  position   Int
  content    String

  // 768 must match the embedding model output size (decided in step 4)
  embedding Unsupported("vector(768)")?

  @@index([bookId, pageNumber])
  @@map("book_chunks")
}

// Cached summaries, computed once and shared by all students
model BookSummaryCache {
  id String @id @default(uuid())

  bookId String @map("book_id")
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  startPage Int    @map("start_page")
  endPage   Int    @map("end_page")
  language  String
  content   String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bookId, startPage, endPage, language])
  @@map("book_summary_cache")
}
