{
  "name": "express-ts-prisma-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run prisma:generate",
    "postinstall": "prisma generate",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/study-table/*.test.ts test/subject/*.test.ts test/notification/*.test.ts test/lesson-date/*.test.ts test/support/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@types/socket.io": "^3.0.1",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "nodemailer": "10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.22.0",
    "puppeteer": "25.11.0",
    "puppeteer-core": "25.11.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pdfkit": "^0.17.6",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "pdfkit": "^0.19.1",
    "prettier": "^3.9.5",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
