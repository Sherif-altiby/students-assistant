// prisma/models/study-subject.prisma
model StudySubject {
  id String @id @default(uuid())

  title String @unique

  chapters StudyChapter[]

  // Where this subject has been planned into a study day.
  dayUsages StudyDaySubject[]

  createdAt DateTime @default(now())

  @@map("study_subjects")
}

model StudyChapter {
  id String @id @default(uuid())

  title String

  order Int @default(0)

  subjectId String       @map("subject_id")
  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  parentId String?        @map("parent_id")
  parent   StudyChapter?  @relation("ChapterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children StudyChapter[] @relation("ChapterTree")

  lessons StudyLesson[]

  createdAt DateTime @default(now())

  @@index([subjectId])
  @@index([parentId])
  @@map("study_chapters")
}