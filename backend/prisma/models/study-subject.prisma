model StudySubject {
  id String @id @default(uuid())

  title String @unique

  units StudyUnit[]

  dayUsages StudyTableSubject[]
  sessions  StudySession[]

  createdAt DateTime @default(now())

  @@map("study_subjects")
}

model StudyUnit {
  id String @id @default(uuid())

  title String

  order Int @default(1)

  subjectId String       @map("subject_id")
  subject   StudySubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  lessons StudyLesson[]

  createdAt DateTime @default(now())

  @@unique([subjectId, order])
  @@index([subjectId])
  @@map("study_units")
}
