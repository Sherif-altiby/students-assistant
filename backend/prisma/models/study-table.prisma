model StudyTable {
  id String @id @default(uuid())

  title String

  type StudyTableType

  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  month             Int?
  year              Int?
  allSubjects       Boolean  @default(true) @map("all_subjects")
  selectedLessonIds String[] @default([]) @map("selected_lesson_ids")
  studyWeekdays     Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @map("study_weekdays")
  maxSessionsPerDay Int      @default(3) @map("max_sessions_per_day")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  days     StudyDay[]
  subjects StudyTableSubject[]
  sessions StudySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("study_tables")
}
